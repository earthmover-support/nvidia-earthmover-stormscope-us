{
  "org": "nvidia",
  "repo": "nvidia/nvidia-earthmover-stormscope-us",
  "branch": "main",

  "tile_base": "https://tiles-dd7cd36ec0562874.compute.arraylake.app/v1/services/tiles/nvidia/nvidia-earthmover-stormscope-us",
  "data_bounds": [-133.712, 21.582, -61.337, 52.145],
  "max_tile_level": 7,

  "variables": {
    "true_color": { "style": "raster/rgb", "colorscalerange": "0,255" },
    "water_vapor": { "style": "raster/rgb", "colorscalerange": "0,255" }
  },

  "lead_steps": 12,
  "lead_step_min": 10,
  "run_interval_min": 5,
  "run_phases_s": { "ic": 2, "step": 3.2, "commit": 0.5 },
  "max_runs": 288,
  "poll_seconds": 5,
  "history_depth": 240,

  "panel_seconds": 25,
  "playback_speed": "medium",
  "hold_first_ms": 2000,
  "hold_ms": 2000,
  "attract_reset_s": 180,
  "location": "SC26 Chicago",
  "venues": {
    "SC26 Chicago":  { "lat": 41.8517, "lon": -87.6167,  "timezone": "America/Chicago" },
    "Washington DC": { "lat": 38.8936, "lon": -77.0311,  "timezone": "America/New_York" },
    "San Francisco": { "lat": 37.7842, "lon": -122.4016, "timezone": "America/Los_Angeles" },
    "Denver":        { "lat": 39.7427, "lon": -104.9963, "timezone": "America/Denver" },
    "San Jose":      { "lat": 37.3297, "lon": -121.8889, "timezone": "America/Los_Angeles" }
  },
  "camera": { "lon": -96.0, "lat": 38.5, "zoom": 3.3, "pitch": 32, "sway_deg": 10, "sway_period_s": 120,
              "cover": [-125, 24, -67, 50], "min_zoom": 2, "max_zoom": 8.5, "idle_reset_s": 30 },

  "viewer_url": "https://nvidia-sc26-chicago-viewer.earthmover.io/",
  "qr_tile": { "z": 5, "x": 8, "y": 11, "size": 512 },

  "sql": {
    "host": "sql-4ae7e8fe159e81b6.compute.arraylake.app",
    "max_rows": 200,
    "box_deg": 0.05,
    "query": [
      "SELECT lead_time, AVG(true_color) AS brightness  -- high means cloudy, low means clear or dark",
      "FROM \"nvidia-earthmover-stormscope-us\".\"root\"",
      "WHERE time = TIMESTAMP '{init}'  -- UTC",
      "  AND lat BETWEEN {lat} - {box} AND {lat} + {box}",
      "  AND lon BETWEEN {lon} - {box} AND {lon} + {box}",
      "GROUP BY lead_time ORDER BY lead_time;"
    ]
  }
}
